<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         TREE
    ========================================================== -->
    <record id="view_strategic_area_tree" model="ir.ui.view">
        <field name="name">strategic.area.tree</field>
        <field name="model">strategic.area</field>
        <field name="arch" type="xml">
            <tree string="Áreas Estratégicas">
                <field name="sequence"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="responsible_id"/>
                <field name="goal_count"/>
                <field name="report_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- =========================================================
         FORM
    ========================================================== -->
    <record id="view_strategic_area_form" model="ir.ui.view">
        <field name="name">strategic.area.form</field>
        <field name="model">strategic.area</field>
        <field name="arch" type="xml">
            <form string="Área Estratégica">
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button type="action"
                                name="%(action_strategic_goal)d"
                                class="oe_stat_button"
                                icon="fa-bullseye"
                                context="{'search_default_area_id': active_id, 'default_area_id': active_id}">
                            <field name="goal_count" string="Metas" widget="statinfo"/>
                        </button>

                        <button type="action"
                                name="%(action_job_report)d"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                context="{'search_default_area_id': active_id, 'default_area_id': active_id}">
                            <field name="report_count" string="Relatórios" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ex.: Tecnologia, Operações, Comercial"/>
                        </h1>
                        <div class="text-muted">
                            <field name="code" placeholder="Código interno"/>
                        </div>
                    </div>

                    <group>
                        <group string="Informação Geral">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Descrição Estratégica">
                            <field name="description" nolabel="1" placeholder="Descreva a finalidade estratégica desta área..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Governança">
                            <group>
                                <group string="Gestores da Área">
                                    <field name="manager_ids"
                                           widget="many2many_tags"
                                           options="{'no_create_edit': False}"
                                           placeholder="Selecione os gestores da área"/>
                                </group>
                                <group string="Visualizadores">
                                    <field name="viewer_ids"
                                           widget="many2many_tags"
                                           options="{'no_create_edit': False}"
                                           placeholder="Selecione utilizadores com acesso de consulta"/>
                                </group>
                            </group>

                            <group string="Funcionários da Área">
                                <field name="employee_ids"
                                       widget="many2many_tags"
                                       options="{'no_create_edit': False}"
                                       placeholder="Selecione os funcionários vinculados à área"/>
                            </group>
                        </page>

                        <page string="Metas">
                            <field name="goal_ids" context="{'default_area_id': active_id, 'default_company_id': company_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="periodicity"/>
                                    <field name="metric_type"/>
                                    <field name="target_value"/>
                                    <field name="unit_of_measure"/>
                                    <field name="priority"/>
                                    <field name="responsible_id"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                 <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
            </form>
        </field>
    </record>

    <!-- =========================================================
         SEARCH
    ========================================================== -->


    <!-- =========================================================
         ACTION
    ========================================================== -->
    <record id="action_strategic_area" model="ir.actions.act_window">
        <field name="name">Áreas Estratégicas</field>
        <field name="res_model">strategic.area</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie a primeira área estratégica.
            </p>
            <p>
                As áreas estratégicas organizam a estrutura de governação, metas, responsáveis e relatórios.
            </p>
        </field>
    </record>

</odoo>