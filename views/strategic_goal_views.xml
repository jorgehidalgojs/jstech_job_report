<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         TREE
    ========================================================== -->
    <record id="view_strategic_goal_tree" model="ir.ui.view">
        <field name="name">strategic.goal.tree</field>
        <field name="model">strategic.goal</field>
        <field name="arch" type="xml">
            <tree string="Metas Estratégicas">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="area_id"/>
                <field name="responsible_id"/>
                <field name="periodicity"/>
                <field name="metric_type"/>
                <field name="target_value"/>
                <field name="unit_of_measure"/>
                <field name="priority"/>
                <field name="criticality"/>
                <field name="report_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- =========================================================
         FORM
    ========================================================== -->
    <record id="view_strategic_goal_form" model="ir.ui.view">
        <field name="name">strategic.goal.form</field>
        <field name="model">strategic.goal</field>
        <field name="arch" type="xml">
            <form string="Meta Estratégica">
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button type="action"
                                name="%(action_job_report)d"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                context="{'search_default_goal_id': active_id, 'default_goal_id': active_id}">
                            <field name="report_count" string="Relatórios" widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ex.: Reduzir bugs críticos, aumentar produtividade, cumprir SLA"/>
                        </h1>
                        <div class="text-muted">
                            <field name="code" placeholder="Código da meta"/>
                        </div>
                    </div>

                    <group>
                        <group string="Estrutura Estratégica">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="area_id"/>
                            <field name="responsible_id"/>
                            <field name="active"/>
                        </group>

                        <group string="Vigência e Governação">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="priority"/>
                            <field name="criticality"/>
                        </group>
                    </group>

                    <group string="Descrição Estratégica">
                        <field name="description" nolabel="1" placeholder="Descreva a meta, seu contexto, alcance e valor para o negócio..."/>
                    </group>

                    <notebook>
                        <page string="Governança">
                            <group>
                                <group string="Gestores da Meta">
                                    <field name="manager_ids"
                                           widget="many2many_tags"
                                           options="{'no_create_edit': False}"
                                           placeholder="Por padrão são herdados da área, podendo adicionar mais gestores"/>
                                </group>
                                <group string="Visualizadores">
                                    <field name="viewer_ids"
                                           widget="many2many_tags"
                                           options="{'no_create_edit': False}"
                                           placeholder="Por padrão são herdados da área, podendo adicionar mais visualizadores"/>
                                </group>
                            </group>

                            <group string="Funcionários Atribuídos">
                                <field name="employee_ids" widget="many2many_tags" readonly="1"/>
                            </group>

                            <group string="Responsável Imediato">
                                <field name="responsible_id"/>
                            </group>
                        </page>

                        <page string="Medição">
    <group>
        <group string="Indicador Principal">
            <field name="periodicity"/>
            <field name="metric_type"/>
            <field name="target_value"/>
            <field name="min_expected_value"/>
            <field name="unit_of_measure"/>
            <field name="weight"/>
        </group>

        <group string="Descrição da Medição">
            <field name="metric_description"
                   nolabel="1"
                   placeholder="Explique como esta meta será medida, de onde vêm os dados e como interpretar os resultados..."/>
        </group>
    </group>

    <separator string="Métricas Específicas"/>

    <field name="specific_metric_ids">
        <tree editable="bottom">
            <field name="sequence" widget="handle"/>
            <field name="metric_name"/>
            <field name="metric_code"/>
            <field name="metric_type"/>
            <field name="unit_of_measure"/>
            <field name="planned_value"/>
            <field name="weight"/>
            <field name="required"/>
            <field name="active"/>
        </tree>

        <form string="Métrica Específica">
            <sheet>
                <group>
                    <group string="Identificação">
                        <field name="sequence"/>
                        <field name="metric_name"/>
                        <field name="metric_code"/>
                        <field name="metric_type"/>
                        <field name="unit_of_measure"/>
                    </group>

                    <group string="Planeamento">
                        <field name="planned_value"/>
                        <field name="weight"/>
                        <field name="required"/>
                        <field name="active"/>
                    </group>
                </group>

                <group string="Descrição da Métrica">
                    <field name="description"
                           nolabel="1"
                           placeholder="Descreva a finalidade, os critérios e a forma de medição desta métrica específica..."/>
                </group>
            </sheet>
        </form>
    </field>
</page>

                        <page string="Entregável">
                            <group string="Descrição do Entregável Esperado">
                                <field name="deliverable_description" nolabel="1" placeholder="Descreva claramente o que deve ser entregue para que a meta seja considerada cumprida..."/>
                            </group>
                        </page>

                        <page string="IA / Metadados" attrs="{'invisible': [('id', '!=', False)]}">
                            <group string="Metadados Analíticos">
                                <field name="ai_metadata_json" nolabel="1"/>
                            </group>
                        </page>

                    </notebook>



                </sheet>
                   <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
            </form>
        </field>
    </record>

    <!-- =========================================================
         SEARCH
    ========================================================== -->


    <!-- =========================================================
         ACTION
    ========================================================== -->
    <record id="action_strategic_goal" model="ir.actions.act_window">
        <field name="name">Metas</field>
        <field name="res_model">strategic.goal</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crie a primeira meta estratégica.
            </p>
            <p>
                As metas estruturam o acompanhamento, a medição, a governação e a geração de relatórios periódicos.
            </p>
        </field>
    </record>

</odoo>