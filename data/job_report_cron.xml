<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_generate_periodic_job_reports" model="ir.cron">
            <field name="name">Generate Periodic Job Reports</field>
            <field name="model_id" ref="model_strategic_goal"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_reports()</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_update_late_job_reports" model="ir.cron">
            <field name="name">Update Late Job Reports</field>
            <field name="model_id" ref="model_job_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_late_reports()</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>